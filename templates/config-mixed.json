{
  "_comment": "sing-box Mixed 客户端模式模板 - 仅 HTTP/SOCKS 代理, 不做透明网关 [sing-box 1.12+ 新格式]",
  "_usage": "适合在设备上单独运行, 其他设备手动设置代理指向此端口。已迁移至 sing-box 1.12+ 新格式。",
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true,
    "output": ""
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "remote-dns",
        "server": "1.1.1.1",
        "detour": "select"
      },
      {
        "type": "udp",
        "tag": "local-dns",
        "server": "223.5.5.5",
        "detour": "direct"
      },
      {
        "type": "udp",
        "tag": "fallback-dns",
        "server": "8.8.8.8",
        "detour": "select"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "local-dns"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "rcode": "SUCCESS"
      }
    ],
    "final": "remote-dns",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 2080,
      "tcp_fast_open": true,
      "udp_fragment": true
    }
  ],
  "outbounds": [
    {
      "tag": "select",
      "type": "selector",
      "outbounds": [
        "auto",
        "direct"
      ],
      "default": "auto"
    },
    {
      "tag": "auto",
      "type": "urltest",
      "outbounds": [
        "direct"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "rule_set": [
          "geosite-category-ads-all"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "download_detour": "select"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "download_detour": "select"
      },
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs",
        "download_detour": "select"
      }
    ],
    "auto_detect_interface": true,
    "final": "select",
    "default_domain_resolver": {
      "server": "local-dns"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/etc/sing-box/cache.db"
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "rule"
    }
  }
}
